{
  "optimized": [
    "%s0 = SCAN",
    "%m1 = MASK %s0, [rating >= 4.0, year <= 2010, year >= 2000]",
    "%a1 = SEM_SEARCH \"heist\", %m1, c=200",
    "%b1 = META_SEARCH genres=[], terms=[heist], %m1, c=200",
    "%f = RRF %a1, %b1, k=60",
    "%r = SOFT %f, prefs=[text:heist+], soft=[]",
    "%t = TOPK %r, n=10",
    "%x = EXPLAIN %t",
    "RET %x"
  ],
  "unoptimized": [
    "%s0 = SCAN",
    "%a1 = SEM_SEARCH \"heist\", %s0, c=N",
    "%a2 = FILTER_LIST %a1, [rating >= 4.0, year <= 2010, year >= 2000], c=200",
    "%b1 = META_SEARCH genres=[], terms=[heist], %s0, c=N",
    "%b2 = FILTER_LIST %b1, [rating >= 4.0, year <= 2010, year >= 2000], c=200",
    "%f = RRF %a2, %b2, k=60",
    "%r = SOFT %f, prefs=[text:heist+], soft=[]",
    "%t = TOPK %r, n=10",
    "%x = EXPLAIN %t",
    "RET %x"
  ]
}

{
  "optimized": [
    "%s0 = SCAN",
    "%m1 = MASK %s0, [votes >= 100]",
    "%a1 = SEM_SEARCH \"romance comedy\", %m1, c=200",
    "%b1 = META_SEARCH genres=[Comedy, Romance], terms=[], %m1, c=200",
    "%f = RRF %a1, %b1, k=60",
    "%r = SOFT %f, prefs=[genre:Comedy+, genre:Romance+], soft=[]",
    "%t = TOPK %r, n=10",
    "%x = EXPLAIN %t",
    "RET %x"
  ],
  "unoptimized": [
    "%s0 = SCAN",
    "%a1 = SEM_SEARCH \"romance comedy\", %s0, c=N",
    "%a2 = FILTER_LIST %a1, [votes >= 100], c=200",
    "%b1 = META_SEARCH genres=[Comedy, Romance], terms=[], %s0, c=N",
    "%b2 = FILTER_LIST %b1, [votes >= 100], c=200",
    "%f = RRF %a2, %b2, k=60",
    "%r = SOFT %f, prefs=[genre:Comedy+, genre:Romance+], soft=[]",
    "%t = TOPK %r, n=10",
    "%x = EXPLAIN %t",
    "RET %x"
  ]
}
